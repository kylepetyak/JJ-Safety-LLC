# Zoho Integration
ZOHO_WEBHOOK_URL=https://flow.zoho.com/YOUR_WEBHOOK_URL_HERE

# Optional: Direct Zoho CRM API (if not using webhook)
# ZOHO_CLIENT_ID=your_client_id
# ZOHO_CLIENT_SECRET=your_client_secret
# ZOHO_REFRESH_TOKEN=your_refresh_token

# Optional: Zoho SalesIQ (Live Chat)
# NEXT_PUBLIC_ZOHO_SALESIQ_CODE=your_salesiq_code

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.jjsafety.com

# Google Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
